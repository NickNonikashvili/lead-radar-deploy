# Mailtabs configuration. Copy this file to .env and adjust.
# Every value here is optional unless noted; the defaults suit running on your own computer.

# Port the web server listens on.
PORT=3000

# The public address people use to open Mailtabs (no trailing slash). Must be correct for
# Google/Microsoft sign-in redirects. Use https:// in production: cookies are marked Secure then.
APP_URL=http://localhost:3000

# Where the database and generated secret key live (relative paths are relative to the app folder).
DATA_DIR=./data

# Encrypts connected accounts' passwords and tokens. Use a long random value, e.g. `openssl rand -hex 32`.
# If unset, one is generated into DATA_DIR/.secret-key. If you lose it, every account must be reconnected.
SECRET_KEY=

# Whether new people can create a Mailtabs login. The very first user can always sign up.
# Set to false after creating your own account on a public server.
ALLOW_SIGNUPS=true

# How often inboxes are checked for new mail (minutes, minimum 1).
SYNC_INTERVAL_MINUTES=3

# How many of the newest messages to download when an account is first connected.
INITIAL_SYNC_LIMIT=200

# Messages larger than this (bytes) are downloaded only when opened.
MAX_BODY_BYTES=5000000

# How many accounts may sync at the same time.
SYNC_CONCURRENCY=4

# Allow IMAP servers on localhost / private networks and unencrypted IMAP. Leave false on shared servers.
ALLOW_PRIVATE_IMAP_HOSTS=false

# Set when running behind a reverse proxy (nginx, Caddy, Traefik…): "true", or the number of proxy hops.
TRUST_PROXY=false

# --- Sign in with Google (Gmail) -------------------------------------------------------------
# Create an OAuth client (type "Web application") in Google Cloud Console, enable the Gmail API,
# and add the redirect URI:  <APP_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Microsoft (Outlook.com, Hotmail, Microsoft 365) ------------------------------
# Register an app in Microsoft Entra ID (Azure portal), add the "IMAP.AccessAsUser.All" delegated
# permission (Office 365 Exchange Online), create a client secret, and add the Web redirect URI:
#   <APP_URL>/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts personal and work accounts; use your tenant ID to restrict to one organisation.
MICROSOFT_TENANT=common
