# Copy to .env and fill in. Used by docker-compose.yml and reset-demo.sh.

# Public host name of the demo (point its DNS A/AAAA record at the VPS first).
DEMO_HOSTNAME=mail-demo.evosoft.solutions
# Contact for Let's Encrypt.
ACME_EMAIL=you@evosoft.solutions
# Encrypts the stored (demo) mailbox passwords. Generate with: openssl rand -hex 32
SECRET_KEY=

# The shared visitor login (created by the seeder on every reset).
DEMO_LOGIN_EMAIL=demo@mailtabs.demo.test
DEMO_LOGIN_PASSWORD=mailtabs-demo
