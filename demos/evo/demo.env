# Evo public demo settings: /etc/evo/evo-demo.env (0640 root:evo-demo).
# Read by the systemd unit (EnvironmentFile=) AND by reset-demo.sh, so keep it in plain KEY=value form.
# Everything not listed here keeps Evo's default. The full list is in .env.example in the release.

# ---- where it runs ----
PORT=3101
DATA_DIR=/var/lib/evo-demo

# ---- the demo company ----
# Loads "Bluefield Market Co." + "Bluefield Campus Store" on a fresh data folder (no setup screen).
SEED_DEMO=true
# Fixed sign-ins, so the portfolio page can list them. Without these, every reset prints new random ones.
DEMO_PASSWORD=demo1234
DEMO_PIN=1234
# The demo's addresses are in Chicago: keep its clock there. (Default: the server's own time zone.)
SEED_TZ=America/Chicago
# Five weeks of store sales history (charts, reports). Leave on for a demo.
# STORE_DEMO_HISTORY=true

# ---- read by reset-demo.sh only (Evo ignores it) ----
# "flag": visitors anywhere can clock in as the employee; the punch is flagged "outside geofence"
# for HR / Payroll to review. Empty = keep the seed's "block" (only someone in downtown Chicago
# could clock in, unless they move the site with "Use my current location").
DEMO_GEOFENCE_MODE=flag

# ---- HTTPS / reverse proxy ----
# Caddy or nginx on the same machine: nothing to set (the default is loopback).
# Render / Railway / Fly.io (one proxy hop): TRUST_PROXY=1.  Docker behind a host proxy: its bridge address.
# TRUST_PROXY=loopback
# Only if the proxy rewrites the Host header:
# ALLOWED_ORIGINS=https://evo-demo.evosoft.solutions

# ---- quieter for a throwaway demo ----
# The demo is reset every few hours; hourly backups of it are just disk churn.
BACKUP_SCHEDULE=off
# No startup self-check summary in the log (it always lists the demo's expected warnings).
# DOCTOR_AT_START=off

# ---- DO NOT SET on the demo ----
# NODE_ENV=production        -> Evo ignores SEED_DEMO and refuses the demo reset (reset-demo.sh stops).
# STORE_ALLOWED_NETWORKS=... -> register/handheld PIN sign-on, override PINs and device enrollment only
#                               from those networks: visitors could not try the register at all.
# SMTP_URL / ALERT_WEBHOOK_URL -> every visitor's owner sign-in from a new address, every "self-approval"
#                               and the daily store digest would be emailed/posted to you; with SMTP the
#                               demo's fake charge-account contacts would also get daily emails.
# HTTPS_REDIRECT=off / COOKIE_SECURE=false -> not needed behind HTTPS; they weaken sessions.
# RATE_LIMIT=off             -> keep the limits on a public server.
# SETUP_TOKEN                -> unused with SEED_DEMO (there is no setup screen), leave unset.
# DEMO_PASSWORD shorter than 8 characters -> ignored; Evo then picks a random one.
