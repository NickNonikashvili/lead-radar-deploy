<%
  // The compact residence card. Params: c (a listing view). Put cards inside <div class="cards">.
  var cardReel = art.reel(c, { compact: true });
  var cardFacts = [t.area(c.facts.areaM2)];
  if (c.facts.bedrooms) cardFacts.push(t.n('residence.bedroomsCount', c.facts.bedrooms));
  if (c.facts.landM2) cardFacts.push(t('residence.plotArea', { v: t.area(c.facts.landM2) }));
  else if (c.hasPool) cardFacts.push(t('features.pool'));
%>
<article class="card lights rv" data-card="<%= c.slug %>">
  <div class="card__media">
    <a class="card__frames card__frames--<%= cardReel.form %>" href="<%= c.url %>" tabindex="-1" aria-hidden="true">
      <% cardReel.frames.forEach(function (f) { %>
        <span class="still"><img src="<%= f.photo.src(640) %>" srcset="<%= f.photo.srcset %>" sizes="<%= f.sizes %>" width="<%= f.photo.w %>" height="<%= f.photo.h %>" alt="<%= f.photo.alt %>" loading="lazy" decoding="async" style="object-position:<%= f.focus %>"></span>
      <% }) %>
    </a>
    <% if (c.hasTour || c.status !== 'for-sale') { %>
      <p class="card__chips">
        <% if (c.status !== 'for-sale') { %><span class="chip"><%= c.statusLabel %></span><% } %>
        <% if (c.hasTour) { %><span class="chip"><i class="dot"></i><%= t('common.tour3d') %></span><% } %>
      </p>
    <% } %>
    <button type="button" class="card__save icon-btn icon-btn--glass" data-save="<%= c.slug %>" aria-pressed="false" aria-label="<%= t('common.save') %>: <%= c.title %>" title="<%= t('common.save') %>">
      <svg class="icon" aria-hidden="true"><use href="#i-heart"/></svg>
    </button>
  </div>
  <div class="card__cap">
    <h3 class="card__title d4"><a href="<%= c.url %>"><%= c.title %></a></h3>
    <p class="card__price num"><% if (c.price) { %><span data-money="<%= c.price.amount %>" data-currency="<%= c.price.currency %>"><%= c.priceLabel %></span><% } else { %><%= c.priceLabel %><% } %></p>
    <ul class="card__facts"><li><%= c.place %></li><% cardFacts.forEach(function (f) { %><li><%= f %></li><% }) %></ul>
  </div>
</article>
