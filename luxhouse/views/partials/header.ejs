<%
  var navItems = [
    { href: url('/residences'), label: t('nav.residences'), active: path.indexOf('/residences') === 0 },
    { href: url('/services'), label: t('nav.services'), active: path === '/services' },
    { href: url('/sell'), label: t('nav.sell'), active: path === '/sell' },
    { href: url('/about'), label: t('nav.about'), active: path === '/about' },
    { href: url('/contact'), label: t('nav.contact'), active: path === '/contact' }
  ];
  var hc = config.contact;
%>
<header class="site-header" data-header>
  <a class="wordmark" href="<%= url('/') %>" aria-label="<%= config.brand %> — <%= t('nav.home') %>" lang="en"><%= config.brand %></a>

  <nav class="site-nav" aria-label="<%= t('nav.menu') %>">
    <% navItems.forEach(function (item) { %>
      <a href="<%= item.href %>"<%- item.active ? ' aria-current="page"' : '' %>><%= item.label %></a>
    <% }) %>
  </nav>

  <div class="site-tools">
    <ul class="switch" aria-label="<%= t('nav.language') %>">
      <% languages.forEach(function (l) { %>
        <li><a href="<%= l.url %>" hreflang="<%= l.code %>" lang="<%= l.code %>" title="<%= l.name %>"<%- l.current ? ' aria-current="true"' : '' %> data-lang-link="<%= l.code %>"><%= l.short %></a></li>
      <% }) %>
    </ul>
    <div class="switch" role="group" aria-label="<%= t('nav.currency') %>" data-currency-switch>
      <button type="button" aria-pressed="true" data-currency-set="USD">USD</button>
      <button type="button" aria-pressed="false" data-currency-set="GEL">GEL</button>
    </div>
    <a class="icon-btn" href="<%= url('/saved') %>" aria-label="<%= t('nav.saved') %>" title="<%= t('nav.saved') %>" data-saved-link<%- path === '/saved' ? ' aria-current="page"' : '' %>>
      <svg class="icon" aria-hidden="true"><use href="#i-heart"/></svg>
      <span class="icon-btn__count num" data-saved-count hidden>0</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn data-open="<%= t('nav.menu') %>" data-close="<%= t('nav.close') %>"><span><%= t('nav.menu') %></span><i aria-hidden="true"></i></button>
  </div>
</header>

<div class="menu" id="menu" data-menu>
  <nav class="menu__nav" aria-label="<%= t('nav.menu') %>">
    <% navItems.forEach(function (item, i) { %>
      <a href="<%= item.href %>"<%- item.active ? ' aria-current="page"' : '' %>><small class="num">0<%= i + 1 %></small><%= item.label %></a>
    <% }) %>
  </nav>
  <div class="menu__foot">
    <% if (hc.phone || hc.email) { %>
      <p class="menu__contact">
        <% if (hc.phone) { %><a class="num" href="<%= hc.phoneHref %>"><%= hc.phone %></a><% } %>
        <% if (hc.email) { %><a href="mailto:<%= hc.email %>"><%= hc.email %></a><% } %>
      </p>
    <% } %>
    <div class="menu__tools">
      <ul class="switch" aria-label="<%= t('nav.language') %>">
        <% languages.forEach(function (l) { %>
          <li><a href="<%= l.url %>" hreflang="<%= l.code %>" lang="<%= l.code %>" title="<%= l.name %>"<%- l.current ? ' aria-current="true"' : '' %> data-lang-link="<%= l.code %>"><%= l.short %></a></li>
        <% }) %>
      </ul>
      <div class="switch" role="group" aria-label="<%= t('nav.currency') %>" data-currency-switch>
        <button type="button" aria-pressed="true" data-currency-set="USD">USD</button>
        <button type="button" aria-pressed="false" data-currency-set="GEL">GEL</button>
      </div>
    </div>
  </div>
</div>
