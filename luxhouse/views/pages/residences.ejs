<%- include('../partials/page-head', { heading: t('residences.title'), lead: t('residences.lead'), eyebrow: t('home.featuredEyebrow') }) %>

<section class="container listing-tools">
  <form class="filters" method="get" action="<%= url('/residences') %>" data-filters aria-label="<%= t('residences.filters') %>">
    <div class="field field--inline">
      <label for="f-location"><%= t('residences.location') %></label>
      <div class="select">
        <select id="f-location" name="location">
          <option value=""><%= t('common.any') %></option>
          <% locations.forEach(function (l) { %><option value="<%= l.key %>"<%= filters.location === l.key ? ' selected' : '' %>><%= l.label %></option><% }) %>
        </select>
        <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg>
      </div>
    </div>
    <div class="field field--inline">
      <label for="f-price"><%= t('residences.maxPrice') %></label>
      <div class="select">
        <select id="f-price" name="maxPrice">
          <option value=""><%= t('common.any') %></option>
          <% [1000000, 1500000, 2500000, 5000000].forEach(function (v) { %><option value="<%= v %>"<%= filters.maxPrice === v ? ' selected' : '' %>><%= t('common.upTo', { v: t.money(v, 'USD') }) %></option><% }) %>
        </select>
        <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg>
      </div>
    </div>
    <div class="field field--inline">
      <label for="f-beds"><%= t('residences.minBedrooms') %></label>
      <div class="select">
        <select id="f-beds" name="minBedrooms">
          <option value=""><%= t('common.any') %></option>
          <% [3, 4, 5].forEach(function (v) { %><option value="<%= v %>"<%= filters.minBedrooms === v ? ' selected' : '' %>><%= v %>+</option><% }) %>
        </select>
        <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg>
      </div>
    </div>
    <div class="field field--inline">
      <label for="f-area"><%= t('residences.minArea') %></label>
      <div class="select">
        <select id="f-area" name="minArea">
          <option value=""><%= t('common.any') %></option>
          <% [300, 400, 500, 600].forEach(function (v) { %><option value="<%= v %>"<%= filters.minArea === v ? ' selected' : '' %>><%= t('common.from', { v: t.area(v) }) %></option><% }) %>
        </select>
        <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg>
      </div>
    </div>
    <div class="field field--inline">
      <label for="f-sort"><%= t('residences.sort') %></label>
      <div class="select">
        <select id="f-sort" name="sort">
          <option value="newest"<%= filters.sort === 'newest' ? ' selected' : '' %>><%= t('residences.sortNewest') %></option>
          <option value="price-desc"<%= filters.sort === 'price-desc' ? ' selected' : '' %>><%= t('residences.sortPriceDesc') %></option>
          <option value="price-asc"<%= filters.sort === 'price-asc' ? ' selected' : '' %>><%= t('residences.sortPriceAsc') %></option>
          <option value="area"<%= filters.sort === 'area' ? ' selected' : '' %>><%= t('residences.sortArea') %></option>
        </select>
        <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg>
      </div>
    </div>
    <div class="filters__checks">
      <label class="check">
        <input type="checkbox" name="pool" value="1"<%= filters.pool ? ' checked' : '' %>>
        <span class="check__box" aria-hidden="true"><svg class="icon"><use href="#i-check"/></svg></span>
        <span class="check__label"><%= t('residences.withPool') %></span>
      </label>
      <% if (anyTour) { %>
        <label class="check">
          <input type="checkbox" name="tour" value="1"<%= filters.tour ? ' checked' : '' %>>
          <span class="check__box" aria-hidden="true"><svg class="icon"><use href="#i-check"/></svg></span>
          <span class="check__label"><%= t('residences.withTour') %></span>
        </label>
      <% } %>
    </div>
    <div class="filters__actions">
      <button type="submit" class="btn btn--primary"><%= t('common.apply') %></button>
      <% if (filtersActive) { %><a class="link-plain" href="<%= url('/residences') %>"><%= t('common.reset') %></a><% } %>
    </div>
  </form>

  <div class="results-bar">
    <p class="results-count" aria-live="polite"><%= t.n('residences.count', cards.length) %></p>
    <% if (cards.length) { %>
      <div class="view-toggle" role="group" aria-label="<%= t('residences.viewGrid') %> / <%= t('residences.viewMap') %>">
        <button type="button" class="view-toggle__btn is-active" data-view-btn="grid" aria-pressed="true"><svg class="icon" aria-hidden="true"><use href="#i-grid"/></svg><%= t('residences.viewGrid') %></button>
        <button type="button" class="view-toggle__btn" data-view-btn="map" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-map"/></svg><%= t('residences.viewMap') %></button>
      </div>
    <% } %>
  </div>
</section>

<section class="container listing-results">
  <% if (cards.length) { %>
    <div class="card-grid" data-view-panel="grid">
      <% cards.forEach(function (c) { %><%- include('../partials/card', { c: c }) %><% }) %>
    </div>
    <div class="map-view" data-view-panel="map" hidden>
      <div class="map map--tall" data-map="residences" data-points="<%= JSON.stringify(mapPoints) %>" role="region" aria-label="<%= t('residences.viewMap') %>"></div>
      <p class="note"><%= t('residences.mapNote') %></p>
    </div>
  <% } else { %>
    <div class="empty">
      <p><%= t('residences.empty') %></p>
      <a class="btn btn--outline" href="<%= url('/residences') %>"><%= t('common.reset') %></a>
    </div>
  <% } %>
</section>
