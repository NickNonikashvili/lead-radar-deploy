<%
  var c = config.contact;
  var addr = pick(c.address);
  var hours = pick(c.hours);
  var hasDetails = c.phone || c.email || c.whatsapp || c.telegram || addr || hours;
%>
<%- include('../partials/page-head', { heading: t('contact.title'), lead: t('contact.lead'), eyebrow: config.brand }) %>

<section class="section section--flush" aria-labelledby="contact-form-title">
  <div class="wrap grid">
    <div class="contact__intro">
      <p class="label"><%= t('contact.detailsTitle') %></p>
      <% if (hasDetails) { %>
        <div class="dl contact__details">
          <dl>
            <% if (c.phone) { %><div><dt><%= t('contact.phone') %></dt><dd class="num"><a class="text-link" href="<%= c.phoneHref %>"><%= c.phone %></a></dd></div><% } %>
            <% if (c.email) { %><div><dt><%= t('contact.email') %></dt><dd><a class="text-link" href="mailto:<%= c.email %>"><%= c.email %></a></dd></div><% } %>
            <% if (c.whatsapp || c.telegram) { %>
              <div>
                <dt><%= t('contact.messengers') %></dt>
                <dd class="contact__links">
                  <% if (c.whatsapp) { %><a class="text-link" href="<%= c.whatsappHref %>" target="_blank" rel="noopener noreferrer">WhatsApp</a><% } %>
                  <% if (c.telegram) { %><a class="text-link" href="<%= c.telegramHref %>" target="_blank" rel="noopener noreferrer">Telegram</a><% } %>
                </dd>
              </div>
            <% } %>
            <% if (addr) { %><div><dt><%= t('contact.address') %></dt><dd><%= addr %></dd></div><% } %>
            <% if (hours) { %><div><dt><%= t('contact.hours') %></dt><dd><%= hours %></dd></div><% } %>
          </dl>
        </div>
      <% } else { %>
        <p class="lead"><%= t('contact.noDetails') %></p>
      <% } %>
      <% if (c.office) { %>
        <div class="contact__map map" data-map="office" data-lat="<%= c.office.lat %>" data-lng="<%= c.office.lng %>" role="region" aria-label="<%= t('contact.address') %>"></div>
      <% } %>
    </div>
    <div class="contact__form" id="inquiry">
      <h2 class="d3 contact__form-title" id="contact-form-title"><%= t('contact.formTitle') %></h2>
      <%- include('../partials/inquiry-form', { type: 'contact', id: 'contact' }) %>
    </div>
  </div>
</section>
