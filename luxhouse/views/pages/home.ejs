<%
  var pad = function (n) { return (n < 10 ? '0' : '') + n; };
  var heroArt = hero ? art.hero(hero) : null;
  var heroNo = hero ? collection.findIndex(function (c) { return c.slug === hero.slug; }) + 1 : 0;
  var tours = collection.filter(function (c) { return c.hasTour; });
  var sellView = hero || collection[0];
  var sellArt = sellView ? art.band(sellView) : null;
  var cc = config.contact;
%>
<!-- Title card: the title sits in the dark, the house rises out of it -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__head wrap grid">
    <h1 class="hero__title d1" id="hero-title"><% t('home.heroTitleLines').forEach(function (line, i) { %><%= i ? ' ' : '' %><span class="mask"><span><%= line %></span></span><% }) %></h1>
    <div class="hero__aside">
      <p class="label hero__label"><%= t('home.heroEyebrow') %></p>
      <p class="hero__text"><%= t('home.heroText') %></p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="#residences"><%= t('home.heroCta') %></a>
        <% if (tourListing) { %><a class="btn btn--glass btn--tour" href="#tour"><i class="dot"></i><%= t('home.heroCta3d') %></a><% } %>
      </div>
    </div>
  </div>
  <% if (hero) { %>
    <figure class="hero__still still" style="--focus:<%= heroArt.focus %>;--focus-narrow:<%= heroArt.focusNarrow %>">
      <img src="<%= heroArt.photo.src(1280) %>" srcset="<%= heroArt.photo.srcset %>" sizes="100vw" width="<%= heroArt.photo.w %>" height="<%= heroArt.photo.h %>" alt="<%= heroArt.photo.alt %>" fetchpriority="high" decoding="async">
    </figure>
    <div class="hero__slate wrap">
      <a class="slate" href="<%= hero.url %>">
        <span class="label"><span><%= t('home.nowShowing') %></span> — <span class="num"><%= pad(heroNo) %> / <%= pad(collection.length) %></span></span>
        <span class="slate__title"><%= hero.title %></span>
        <span class="slate__meta"><%= hero.place %> · <% if (hero.price) { %><span class="num" data-money="<%= hero.price.amount %>" data-currency="<%= hero.price.currency %>"><%= hero.priceLabel %></span><% } else { %><%= hero.priceLabel %><% } %></span>
      </a>
      <a class="hero__next" href="#residences"><span class="label"><%= t.n('residences.count', collection.length) %></span><svg class="icon" aria-hidden="true"><use href="#i-arrow-down"/></svg></a>
    </div>
  <% } %>
</section>

<!-- The collection: one strip of stills and one caption row per residence -->
<section class="collection" id="residences" aria-labelledby="collection-title">
  <header class="sec-head wrap grid">
    <p class="sec-head__label label"><%= t('home.featuredEyebrow') %><b class="num"><%= pad(collection.length) %></b></p>
    <h2 class="sec-head__title d2" id="collection-title"><%= t('home.featuredTitle') %></h2>
    <p class="sec-head__aside"><%= t('home.featuredText') %></p>
  </header>
  <div class="collection__list reels">
    <% collection.forEach(function (c, i) { %><%- include('../partials/reel', { c: c, no: i + 1 }) %><% }) %>
  </div>
  <% if (collection.length < residenceCount) { %>
    <p class="collection__all wrap"><a class="link" href="<%= url('/residences') %>"><span><%= t('common.viewAll') %></span><svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a></p>
  <% } %>
</section>

<!-- The 3D tour -->
<section class="tour" id="tour" aria-labelledby="tour-title">
  <% if (tourListing) { %>
    <%- include('../partials/stage', { r: tourListing, eyebrow: t('home.tourEyebrow'), lines: t('home.tourTitleLines'), titleId: 'tour-title' }) %>
  <% } else { %>
    <header class="sec-head wrap grid">
      <p class="sec-head__label label"><%= t('home.tourEyebrow') %></p>
      <h2 class="sec-head__title d2" id="tour-title"><%= t('home.tourTitle') %></h2>
      <p class="sec-head__aside"><%= t('home.tourSoon') %></p>
    </header>
  <% } %>
  <div class="tour__notes wrap grid">
    <p class="tour__text lead rv"><%= t('home.tourText') %></p>
    <ul class="tour__points rv">
      <% [1, 2, 3].forEach(function (n) { %><li><b class="num"><%= pad(n) %></b><%= t('home.tourPoint' + n) %></li><% }) %>
    </ul>
  </div>
  <% if (tours.length) { %>
    <nav class="doors" aria-label="<%= t('common.tour3d') %>" style="--doors:<%= Math.min(tours.length, 3) %>">
      <% tours.forEach(function (c, i) { %>
        <a class="door" href="<%= c.tourUrl %>"><span class="label label--dim num"><%= pad(i + 1) %></span><span class="door__name"><%= c.title %></span><span class="door__go"><i class="dot"></i><span><%= t('common.tour3d') %></span><svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></span></a>
      <% }) %>
    </nav>
  <% } %>
</section>

<!-- How we work -->
<section class="section" id="approach" aria-labelledby="how-title">
  <div class="wrap grid">
    <header class="how__head">
      <p class="label"><%= t('home.approachEyebrow') %></p>
      <h2 class="d2" id="how-title"><%= t('home.approachTitle') %></h2>
      <p class="body"><%= t('about.paragraphs')[0].replace(/\{brand\}/g, config.brand) %></p>
    </header>
    <ol class="how__list">
      <% [1, 2, 3].forEach(function (n) { %>
        <li class="how__item rv">
          <span class="label label--dim num"><%= pad(n) %></span>
          <h3 class="d3"><%= t('home.approach' + n + 'Title') %></h3>
          <p class="body"><%= t('home.approach' + n + 'Text') %></p>
        </li>
      <% }) %>
    </ol>
  </div>

  <div class="services wrap" id="services">
    <header class="services__head grid">
      <p class="label"><%= t('home.servicesEyebrow') %></p>
      <h3 class="d3"><%= t('home.servicesTitle') %></h3>
      <a class="link" href="<%= url('/services') %>"><span><%= t('common.learnMore') %></span><svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
    </header>
    <dl class="credits">
      <% t('services.items').forEach(function (s, i) { %>
        <div class="rv">
          <dt><small class="num"><%= pad(i + 1) %></small><%= s.title %></dt>
          <dd><%= s.text %></dd>
        </div>
      <% }) %>
    </dl>
  </div>
</section>

<!-- Selling -->
<section class="band" id="sell" aria-labelledby="sell-title">
  <% if (sellArt) { %>
    <figure class="band__media still drift" style="--focus:<%= sellArt.focus %>">
      <img src="<%= sellArt.photo.src(1280) %>" srcset="<%= sellArt.photo.srcset %>" sizes="(min-width: 900px) 58vw, 100vw" width="<%= sellArt.photo.w %>" height="<%= sellArt.photo.h %>" alt="<%= sellArt.photo.alt %>" loading="lazy" decoding="async">
    </figure>
  <% } %>
  <div class="band__body wrap grid">
    <p class="label"><%= t('home.sellEyebrow') %></p>
    <h2 class="d2" id="sell-title"><%= t('home.sellTitle') %></h2>
    <p class="lead"><%= t('home.sellText') %></p>
    <a class="btn btn--solid" href="<%= url('/sell') %>"><%= t('home.sellCta') %><svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
  </div>
</section>

<!-- Contact -->
<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div class="contact__intro">
      <p class="label"><%= t('nav.contact') %></p>
      <h2 class="d2" id="contact-title"><%= t('home.contactTitle') %></h2>
      <p class="lead"><%= t('home.contactText') %></p>
      <p class="small"><%= t('about.paragraphs')[2].replace(/\{brand\}/g, config.brand) %></p>
      <% if (cc.phone || cc.email) { %>
        <ul class="contact__direct">
          <% if (cc.phone) { %><li><a class="link num" href="<%= cc.phoneHref %>"><span><%= cc.phone %></span></a></li><% } %>
          <% if (cc.email) { %><li><a class="link" href="mailto:<%= cc.email %>"><span><%= cc.email %></span></a></li><% } %>
        </ul>
      <% } %>
    </div>
    <div class="contact__form">
      <%- include('../partials/inquiry-form', { type: 'contact', id: 'home', subject: false }) %>
    </div>
  </div>
</section>
