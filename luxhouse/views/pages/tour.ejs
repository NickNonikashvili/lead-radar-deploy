<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<link rel="canonical" href="<%= canonical %>">
<% Object.entries(alternates).forEach(function (entry) { %><link rel="alternate" hreflang="<%= entry[0] %>" href="<%= origin + entry[1] %>">
<% }) %><meta property="og:type" content="website">
<meta property="og:site_name" content="<%= config.brand %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= origin + ogImage %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0a09">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="<%= asset('/vendor/fonts/fonts.css') %>">
<link rel="stylesheet" href="<%= asset('/css/tour.css') %>">
</head>
<body>
<%- include('../partials/icons') %>
<%
  var S = tourData.strings;
  var n = tourData.scenes.length;
  var pad = function (i) { return i < 10 ? '0' + i : String(i); };
  var hasRooms = tourData.scenes.some(function (s) { return s.world; });
%>
<div class="tour" data-tour data-state="loading" data-mode="photo">
  <canvas class="tour-canvas" tabindex="0" aria-label="<%= t('tour.title', { title: r.title }) %>"></canvas>
  <canvas class="tour-veil" data-veil hidden aria-hidden="true"></canvas>
  <div class="tour-fade is-on" data-fade aria-hidden="true"></div>
  <div class="tour-progress" data-progress hidden aria-hidden="true"><i></i></div>

  <div class="tour-ui" data-ui>
    <header class="tour-top">
      <a class="tour-back" href="<%= r.url %>" aria-label="<%= S.back %>">
        <svg class="icon" aria-hidden="true"><use href="#i-arrow-left"/></svg>
        <span class="tour-back__text">
          <span class="tour-label"><i class="tour-dot" aria-hidden="true"></i><%= t('common.tour3d') %></span>
          <strong class="tour-back__title"><%= r.title %></strong>
        </span>
      </a>
      <div class="tour-actions">
        <button type="button" class="tour-btn" data-auto aria-pressed="false" aria-label="<%= S.auto %>" title="<%= S.auto %>"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg></button>
        <button type="button" class="tour-btn" data-vr hidden aria-label="<%= S.vr %>" title="<%= S.vr %>"><svg class="icon" aria-hidden="true"><use href="#i-vr"/></svg></button>
        <button type="button" class="tour-btn" data-fullscreen aria-pressed="false" aria-label="<%= S.fullscreen %>" title="<%= S.fullscreen %>"><svg class="icon" aria-hidden="true"><use href="#i-expand"/></svg></button>
        <button type="button" class="tour-btn" data-help aria-expanded="false" aria-controls="tour-help" aria-label="<%= S.help %>" title="<%= S.help %>"><svg class="icon" aria-hidden="true"><use href="#i-help"/></svg></button>
      </div>
    </header>

    <p class="tour-hint" data-hint hidden>
      <span class="tour-hint__mouse is-photo"><%= S.hintMouse %></span>
      <span class="tour-hint__touch is-photo"><%= S.hintTouch %></span>
      <span class="tour-hint__mouse is-room"><%= S.hintWalkMouse %></span>
      <span class="tour-hint__touch is-room"><%= S.hintWalkTouch %></span>
    </p>

    <ol class="tour-strip" id="tour-strip" data-strip hidden aria-label="<%= S.spaces %>">
      <% tourData.scenes.forEach(function (s, i) { %>
        <li>
          <button type="button" class="tour-thumb" data-scene="<%= i %>">
            <img src="<%= tourData.base + s.base %>thumb.webp" alt="" width="120" height="80" loading="lazy" decoding="async">
            <span class="tour-thumb__no"><%= pad(i + 1) %></span>
            <% if (s.world) { %><span class="tour-thumb__ai" title="<%= S.world %>">3D</span><% } else if (s.generated) { %><span class="tour-thumb__ai" title="<%= S.generated %>">AI</span><% } %>
            <span class="tour-thumb__name"><%= s.label || pad(i + 1) %></span>
          </button>
        </li>
      <% }) %>
    </ol>

    <footer class="tour-bottom">
      <div class="tour-where" aria-live="polite">
        <span class="tour-where__count" data-scene-count></span>
        <strong class="tour-where__name" data-scene-name></strong>
        <span class="tour-where__ai" data-generated hidden><%= S.generated %></span>
      </div>

      <nav class="tour-pad" aria-label="<%= S.spaces %>">
        <button type="button" class="tour-pad__next" data-next aria-label="<%= S.next %>">
          <span class="tour-pad__label"><span class="tour-pad__name" data-next-name></span></span>
        </button>
        <button type="button" class="tour-pad__prev" data-prev aria-label="<%= S.prev %>"></button>
        <svg class="tour-pad__floor" viewBox="0 0 240 104" aria-hidden="true" focusable="false">
          <ellipse class="tour-pad__ring" cx="120" cy="56" rx="112" ry="40"/>
          <ellipse class="tour-pad__glow" cx="120" cy="56" rx="112" ry="40"/>
          <path class="tour-pad__far" d="M100 31 L120 19 L140 31"/>
          <path class="tour-pad__fwd" d="M92 55 L120 36 L148 55"/>
          <path class="tour-pad__back" d="M106 76 L120 86 L134 76"/>
        </svg>
      </nav>

      <div class="tour-tools">
        <button type="button" class="tour-chip" data-strip-toggle aria-expanded="false" aria-controls="tour-strip">
          <svg class="icon" aria-hidden="true"><use href="#i-grid"/></svg><span><%= S.spaces %></span><span class="tour-chip__n"><%= pad(n) %></span>
        </button>
        <a class="tour-chip tour-chip--solid" href="<%= r.url %>#inquiry" aria-label="<%= t('common.requestViewing') %>"><svg class="icon tour-chip__phone" aria-hidden="true"><use href="#i-chat"/></svg><span><%= t('common.requestViewing') %></span><svg class="icon tour-chip__arrow" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
      </div>
    </footer>
  </div>

  <aside class="tour-help" id="tour-help" data-help-panel hidden role="dialog" aria-modal="false" aria-labelledby="tour-help-title">
    <header class="tour-help__head">
      <h2 class="tour-help__title" id="tour-help-title"><%= S.help %></h2>
      <button type="button" class="tour-btn" data-help-close aria-label="<%= S.close %>"><svg class="icon" aria-hidden="true"><use href="#i-close"/></svg></button>
    </header>
    <ol class="tour-help__list tour-help__list--mouse is-photo">
      <li><%= S.helpDrag %></li>
      <li><%= S.helpStep %></li>
      <li><%= S.helpDeeper %></li>
      <li><%= S.helpWalkOn %> <span class="tour-keys" aria-hidden="true"><kbd>W</kbd><kbd>↑</kbd></span></li>
      <li><%= S.helpArrows %></li>
    </ol>
    <ol class="tour-help__list tour-help__list--touch is-photo">
      <li><%= S.helpTouchLook %></li>
      <li><%= S.helpTouchStep %></li>
      <li><%= S.helpArrows %></li>
    </ol>
    <ol class="tour-help__list tour-help__list--mouse is-room">
      <li><%= S.helpDrag %></li>
      <li><%= S.helpWalkKeys %> <span class="tour-keys" aria-hidden="true"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></span></li>
      <li><%= S.helpWalkClick %></li>
      <li><%= S.helpWalkScroll %></li>
      <li><%= S.helpArrows %></li>
    </ol>
    <ol class="tour-help__list tour-help__list--touch is-room">
      <li><%= S.helpTouchLook %></li>
      <li><%= S.helpWalkTap %></li>
      <li><%= S.helpWalkStick %></li>
      <li><%= S.helpArrows %></li>
    </ol>
    <p class="tour-help__note"><%= S.note %></p>
    <p class="tour-help__note" data-note-world<%- hasRooms ? '' : ' hidden' %>><%= S.noteWorld %></p>
    <% if (tourData.scenes.some(function (s) { return s.generated && !s.world; })) { %><p class="tour-help__note"><%= S.noteGenerated %></p><% } %>
  </aside>

  <div class="tour-stick" data-stick hidden aria-hidden="true"><i class="tour-stick__knob"></i></div>

  <div class="tour-loader" data-loader role="status">
    <p class="tour-label"><i class="tour-dot" aria-hidden="true"></i><%= t('common.tour3d') %></p>
    <p class="tour-loader__title"><%= r.title %></p>
    <span class="tour-loader__bar" aria-hidden="true"></span>
    <p class="tour-loader__text"><%= S.loading %></p>
  </div>

  <div class="tour-error" data-error hidden role="alert">
    <p class="tour-error__text" data-error-text><%= S.loadError %></p>
    <p class="tour-error__actions">
      <button type="button" class="tour-chip tour-chip--solid" data-retry><%= S.retry %></button>
      <a class="tour-chip" href="<%= r.url %>#gallery"><%= S.openGallery %></a>
    </p>
  </div>

  <noscript><div class="tour-error"><p class="tour-error__text"><%= S.noWebgl %></p><p class="tour-error__actions"><a class="tour-chip" href="<%= r.url %>#gallery"><%= S.openGallery %></a></p></div></noscript>
</div>
<script type="application/json" id="tour-data"><%- jsonLd(tourData) %></script>
<script type="module" src="<%= asset('/js/tour.bundle.js') %>"></script>
</body>
</html>
