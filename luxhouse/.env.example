# Copy to .env and fill in. Never commit the real .env file.

# Public address of the site (no trailing slash). Used for canonical links, sitemap and social previews.
BASE_URL=

# Port to listen on (most hosts set this for you).
PORT=3100

# Set to "production" on the live server.
NODE_ENV=

# If the site runs behind a proxy/load balancer (Render, Railway, nginx…), set to 1 so visitor IPs are read correctly.
TRUST_PROXY=

# Enquiry inbox at /admin. Leave ADMIN_PASSWORD empty to disable the inbox entirely.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Email notification for each new enquiry (optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# POST each new enquiry as JSON to this URL (optional; e.g. a Zapier/Make hook or your CRM).
LEAD_WEBHOOK_URL=

# Where enquiries are stored. Point this at a persistent disk on hosts that wipe the app folder on deploy.
DATA_DIR=
