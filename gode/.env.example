# Gode configuration. Copy to .env and fill in what you need: cp .env.example .env
# Every variable is optional for a local demo: with no gateway key at all, Gode runs in mock mode.
# Empty value = use the default. Never commit .env (it is in .gitignore).

# ---------- Server ----------
# "production" turns on secure cookies, HSTS, the trusted proxy and the master-key requirement.
NODE_ENV=
# Port the web server listens on.
PORT=3000
# The address people use to reach Gode (Stripe redirects and OpenRouter attribution use it). No trailing slash.
PUBLIC_URL=http://localhost:3000
# Folder for the database (and the dev master key). Point it at a persistent disk in production.
DATA_DIR=data
# Full path to the SQLite file. Default: <DATA_DIR>/gode.db
DATABASE_PATH=
# Trust X-Forwarded-* from a reverse proxy (Render, Railway, nginx). Default: on in production.
TRUST_PROXY=
# Send cookies over HTTPS only. Default: on in production.
COOKIE_SECURE=
# How long a login lasts, in days.
SESSION_DAYS=30
# Comma-separated emails that become admins when they sign up (the very first account is always admin).
ADMIN_EMAILS=

# ---------- Encryption ----------
# 32 random bytes, base64. Encrypts every user's data key. REQUIRED in production; back it up
# separately from the database (lose it and stored chats can never be read again).
# Generate: openssl rand -base64 32
GODE_MASTER_KEY=

# ---------- Mock mode ----------
# 1 = offline demo (fake answers, no AI calls), 0 = real gateways. Empty = automatic: mock when not
# in production and no gateway key is set.
GODE_MOCK=

# ---------- Model gateways ----------
# OpenRouter: all text and code models, and the openrouter/auto benchmark baseline. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Only change for a proxy or a test server.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# fal: image, video, music and voice models. https://fal.ai/dashboard/keys
FAL_KEY=
# fal queue API base URL.
FAL_QUEUE_BASE_URL=https://queue.fal.run
# How often to poll a running fal job, in milliseconds.
FAL_POLL_INTERVAL_MS=1500
# Give up on a fal job after this many milliseconds (default 10 minutes).
FAL_TIMEOUT_MS=600000
# Optional: direct OpenAI (GPT models, gpt-image quality pick, classifier fallback). https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Only change for a proxy or a test server.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: your own OpenAI-compatible server (vLLM, Ollama, TGI) for the private tier, e.g. http://10.0.0.5:8000/v1
SELFHOSTED_BASE_URL=
# Key for that server, if it needs one.
SELFHOSTED_API_KEY=

# ---------- Router ----------
# Model id of the classifier (e.g. openrouter:deepseek/deepseek-v4.1-flash). Empty = built-in default list.
CLASSIFIER_MODEL_ID=
# Private request and no self-hosted model available: "zdr" = use a zero-retention model after
# redaction, "block" = refuse the request.
PRIVATE_FALLBACK=zdr
# Longest answer, in tokens.
MAX_OUTPUT_TOKENS=4096
# How many earlier messages of a conversation are sent with each request.
HISTORY_MESSAGES=30

# ---------- Privacy ----------
# Replace personal details with placeholders before a prompt leaves ("on" or "off"). Keep it on.
REDACTION=on
# Mask card numbers, IBANs, secrets etc. that a model writes into its answer ("on" or "off").
RESPONSE_FILTER=on
# Presidio analyzer for better name/place detection (see presidio/README.md), e.g. http://localhost:5002
PRESIDIO_ANALYZER_URL=
# Ignore Presidio findings below this confidence (0 to 1).
PRESIDIO_SCORE_THRESHOLD=0.5
# Language Presidio analyses.
PRESIDIO_LANGUAGE=en
# Also redact prompts sent to your self-hosted models (they never leave your servers, so off by default).
REDACT_SELF_HOSTED=false

# ---------- Billing ----------
# Margin on top of API cost: 0.3 means a user pays $1.30 for $1.00 of model usage.
CREDIT_MARGIN=0.3
# Free credit for each new account, in USD.
SIGNUP_CREDIT_USD=0.25
# Credit packs offered on the billing page, in USD, comma-separated.
CREDIT_PACKS=5,10,25
# Stripe currency (a two-decimal currency such as usd or eur).
CURRENCY=usd
# Stripe secret key (sk_test_... while testing, sk_live_... or a restricted rk_live_... in production).
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (whsec_...), from Stripe Dashboard > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=
# Only change for a test server.
STRIPE_API_BASE=https://api.stripe.com
# Show a free "add test credit" button (development only; ignored when NODE_ENV=production).
ALLOW_DEV_TOPUP=false

# ---------- Weekly learner (npm run learn) ----------
# A model needs at least this many requests in the window before the learner trusts its ratings.
LEARN_MIN_SAMPLES=20
# How many days of history the learner reads.
LEARN_WINDOW_DAYS=28
