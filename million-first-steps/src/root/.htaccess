# Settings for Apache / LiteSpeed hosting (e.g. Hostinger). Other hosts ignore this file.
# Pages are files such as about.html and tours/index.html; visitors see clean addresses: /about, /tours/.
DirectoryIndex index.html index.php
# Unknown addresses get the 404 page, in the visitor's language under /ru/, /ka/… (see the rewrite below).
ErrorDocument 404 /404.html
Options -Indexes -MultiViews

# ── Never served: hidden files (except under .well-known), databases, logs and settings ──────────────
<FilesMatch "(^\.|\.(sqlite3?|sqlite-wal|sqlite-shm|sqlite3-wal|sqlite3-shm|db|log|ini|lock)$|^(error_log|php_errorlog)$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hidden folders too (.git/…), except .well-known (used for SSL certificates).
  RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F]

  # The 404 page in the visitor's language: an unknown address under /ru/ gets ru/404.html (THE_REQUEST
  # is still the address the visitor asked for while the error page is fetched; the status stays 404).
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(ru|ka|es|fr|it|pt|de|zh)/
  RewriteRule ^404\.html$ %1/404.html [L]

  # Doubled slashes (/tours//cradle-of-wine) go to the single-slash address, so relative links keep working.
  RewriteCond %{THE_REQUEST} ^(?:GET|HEAD)\s((?:/[^/?\s]+)*)//+([^?\s]*)
  RewriteRule ^ %1/%2 [R=301,NE,L]

  # Until the owners first save settings in the admin panel there's no api/live.json: answer "no changes"
  # instead of a 404 (which browsers would log on every page).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/live\.json$ assets/live-none.json [L]

  # The admin panel and the visit counter are PHP and look after themselves.
  RewriteRule ^(?:admin|api)(?:/|$) - [L]

  # Pages from earlier versions of the site moved (also under each language, e.g. /ru/history.html).
  RewriteCond %{REQUEST_URI} ^(.*/)tours\.html$
  RewriteRule ^(?:[a-z]{2}/)?tours\.html$ %1tours/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^(.*/)travel-guide(?:\.html)?/?$
  RewriteRule ^(?:[a-z]{2}/)?travel-guide(?:\.html)?/?$ %1guide/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^(.*/)plan(?:\.html)?/?$
  RewriteRule ^(?:[a-z]{2}/)?plan(?:\.html)?/?$ %1guide/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^(.*/)history(?:\.html)?/?$
  RewriteRule ^(?:[a-z]{2}/)?history(?:\.html)?/?$ %1discover-georgia [R=301,L]
  RewriteCond %{REQUEST_URI} ^(.*/)destinations(?:\.html)?/?$
  RewriteRule ^(?:[a-z]{2}/)?destinations(?:\.html)?/?$ %1 [R=301,L]

  # Asked for a file name? Send visitors to the clean address: /index.html → /, /ru/index.html → /ru/,
  # /tours/index.html → /tours/, /about.html → /about. THE_REQUEST is what the browser asked for, so the
  # rewrites below (about → about.html) never loop. The query string is kept.
  # /about/index.html → /about in one step (there's no about/ folder, only the page).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}::$1 ^(?:.*/)?([^/]+)::\1$
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^?\s]*[^/?\s])/+index(?:\.html)?/?[?\s]
  RewriteRule (?:^|/)([^/]+)/+index(?:\.html)?/?$ %1 [R=301,NE,L]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^?\s]*/)index(?:\.html)?/?[?\s]
  RewriteRule (?:^|/)index(?:\.html)?/?$ %1 [R=301,NE,L]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^?\s]*?)\.html[?\s]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(?!(?:[a-z]{2}/)?404\.html$).+\.html$ %1 [R=301,NE,L]

  # /about/ → /about (when about.html exists and there's no folder of that name). The "::" test makes sure
  # the address names that page itself, not something below it (/about/x stays a 404).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}::$1 ^(?:.*/)?([^/]+)/?::(?:.*/)?\1$
  RewriteCond %{REQUEST_FILENAME} ^(.+?)/?$
  RewriteCond %1.html -f
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^(.+)/$ %1 [R=301,L]

  # /about is served from about.html (but /404 isn't a page).
  RewriteCond $1 !(?:^|/)404$
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}::$1 ^(?:.*/)?([^/]+)::(?:.*/)?\1$
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
  AddType application/json .json
  AddCharset utf-8 .html .css .js .json .txt .xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json text/plain application/xml
</IfModule>

<IfModule mod_headers.c>
  # The admin panel sends its own, stricter headers.
  SetEnvIf Request_URI "/admin(/|$)" MFS_ADMIN
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=!MFS_ADMIN
  # Other websites can't show these pages in a frame (the forms included). The admin panel has its own,
  # stricter policy.
  Header always set X-Frame-Options "SAMEORIGIN" env=!MFS_ADMIN
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'" env=!MFS_ADMIN
  # Compressed answers carry the file's ETag plus "-gzip", which never matched when the browser sent it back,
  # so every view downloaded the page again. Without the suffix it's compared with the file: "304 Not Modified".
  RequestHeader edit "If-None-Match" "^\"(.*)-gzip\"$" "\"$1\""
  <FilesMatch "\.(css|js|webp|png|jpg|svg|woff2|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
