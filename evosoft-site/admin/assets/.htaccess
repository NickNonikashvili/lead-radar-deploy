# EvoSoft admin panel: only its stylesheets and scripts. © 2026 EvoSoft Solutions.
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "">
    Require all denied
  </FilesMatch>
  <FilesMatch "^[a-z0-9-]+\.(css|js)$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
  <FilesMatch "^[a-z0-9-]+\.(css|js)$">
    Order deny,allow
    Allow from all
  </FilesMatch>
</IfModule>
