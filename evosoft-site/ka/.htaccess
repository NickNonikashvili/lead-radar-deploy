# ქართული (/ka/): this folder's own "page not found" page and its clean addresses, like the main .htaccess.
# Generated by site-builder/build.mjs. © 2026 EvoSoft Solutions.
ErrorDocument 404 /ka/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /ka/
  # old addresses: /ka/index.html -> /ka/home, /ka/services.html -> /ka/services (the query string is kept)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+ka/((?:[^?\s]*/)?)index\.html[?\s]
  RewriteRule ^ /ka/%1home [R=301,L,NE]
  RewriteRule ^pricing(\.html|/)?$ /ka/contact [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{THE_REQUEST} \s/+ka/([^?\s]+?)\.html[?\s]
  RewriteRule ^ /ka/%1 [R=301,L,NE]
  RewriteRule ^$ /ka/home [R=301,L]
  RewriteRule ^work/?$ /ka/portfolio [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /ka/$1 [R=301,L]
  RewriteRule ^404$ - [R=404,L]
  # clean addresses -> the files
  RewriteRule ^home$ index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
