# EvoSoft website: Apache / Hostinger / LiteSpeed settings. © 2026 EvoSoft Solutions.
ErrorDocument 404 /404.html

# Server settings files are never served (hosts usually block them already).
<IfModule mod_authz_core.c>
  <FilesMatch "^\.ht">
    Require all denied
  </FilesMatch>
</IfModule>

# Clean addresses. The pages are files like services.html and work/evo.html, but the site links to /services and
# /work/evo, and the home page is /home. These rules serve the files at the clean addresses and send every old address
# (/, /index.html, /services.html, /services/) to the clean one with a permanent redirect, keeping any query string.
# The Spanish folder (es/) has the same rules in its own .htaccess (written by site-builder/build.mjs).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # the demo subdomains, if one lives in a folder of this site, are left alone
  RewriteCond %{HTTP_HOST} -demo\. [NC]
  RewriteRule ^ - [L]
  # the Georgian and Russian versions were removed: /ka/... and /ru/... go to the same page in English
  RewriteRule ^(?:ka|ru)/?$ /home [R=301,L]
  RewriteRule ^(?:ka|ru)/(.+)$ /$1 [R=301,L,NE]
  # (only for the visitor's own request, not when the server shows the "page not found" page)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?)index\.html[?\s]
  RewriteRule ^ /%1home [R=301,L,NE]
  # the old prices page is now the website price estimate; /work on its own is the work page
  RewriteRule ^pricing(\.html|/)?$ /estimate [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[?\s]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteRule ^$ /home [R=301,L]
  RewriteRule ^work/?$ /portfolio [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  RewriteRule ^404$ - [R=404,L]
  RewriteRule ^index$ /home [R=301,L]
  # clean addresses -> the files (only a whole address: /services/extra must not borrow services.html, or it loops)
  RewriteRule ^home$ index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{PATH_INFO} ^$
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType text/plain .txt .md

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # CSS, JS and fonts are linked with ?v=<content hash>, so they can be cached for a long time.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/xml "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Pages are always checked for a newer version. Every file a page uses is linked with ?v=<hash of its contents>,
  # so a changed stylesheet or script gets a new address and can't be served stale from a browser's cache.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sitemap\.xml|robots\.txt|llms\.txt|site\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml
</IfModule>
