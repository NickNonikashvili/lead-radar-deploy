# Русский (/ru/): this folder's own "page not found" page and its clean addresses, like the main .htaccess.
# Generated by site-builder/build.mjs. © 2026 EvoSoft Solutions.
ErrorDocument 404 /ru/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /ru/
  # old addresses: /ru/index.html -> /ru/home, /ru/services.html -> /ru/services (the query string is kept)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+ru/((?:[^?\s]*/)?)index\.html[?\s]
  RewriteRule ^ /ru/%1home [R=301,L,NE]
  RewriteRule ^pricing(\.html|/)?$ /ru/contact [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{THE_REQUEST} \s/+ru/([^?\s]+?)\.html[?\s]
  RewriteRule ^ /ru/%1 [R=301,L,NE]
  RewriteRule ^$ /ru/home [R=301,L]
  RewriteRule ^work/?$ /ru/portfolio [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /ru/$1 [R=301,L]
  RewriteRule ^404$ - [R=404,L]
  RewriteRule ^index$ /ru/home [R=301,L]
  # clean addresses -> the files (only a whole address: /ru/services/extra must not borrow services.html, or it loops)
  RewriteRule ^home$ index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{PATH_INFO} ^$
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>
