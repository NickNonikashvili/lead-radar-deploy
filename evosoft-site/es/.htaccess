# Español (/es/): this folder's own "page not found" page and its clean addresses, like the main .htaccess.
# Generated by site-builder/build.mjs. © 2026 EvoSoft Solutions.
ErrorDocument 404 /es/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /es/
  # old addresses: /es/index.html -> /es/home, /es/services.html -> /es/services (the query string is kept)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+es/((?:[^?\s]*/)?)index\.html[?\s]
  RewriteRule ^ /es/%1home [R=301,L,NE]
  RewriteRule ^pricing(\.html|/)?$ /es/contact [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{THE_REQUEST} \s/+es/([^?\s]+?)\.html[?\s]
  RewriteRule ^ /es/%1 [R=301,L,NE]
  RewriteRule ^$ /es/home [R=301,L]
  RewriteRule ^work/?$ /es/portfolio [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /es/$1 [R=301,L]
  RewriteRule ^404$ - [R=404,L]
  RewriteRule ^index$ /es/home [R=301,L]
  # clean addresses -> the files (only a whole address: /es/services/extra must not borrow services.html, or it loops)
  RewriteRule ^home$ index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{PATH_INFO} ^$
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>
